generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  id       Int    @id @default(autoincrement())
  username String @db.VarChar(100)
  password String @db.VarChar(255)
}

model blogs {
  id               Int           @id @default(autoincrement())
  title            String        @db.VarChar(255)
  slug             String        @unique(map: "slug") @db.VarChar(255)
  image            Bytes?
  content          String        @db.LongText
  meta_title       String?       @db.VarChar(255)
  meta_description String?       @db.VarChar(500)
  blog_points      String?       @db.LongText
  author           String?       @default("Admin") @db.VarChar(100)
  status           blogs_status? @default(draft)
  published_at     DateTime?     @db.DateTime(0)
  created_at       DateTime?     @default(now()) @db.Timestamp(0)
  updated_at       DateTime?     @default(now()) @db.Timestamp(0)
}

model contact_messages {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  phone_number String    @db.VarChar(50)
  email        String    @db.VarChar(255)
  subject      String    @db.VarChar(255)
  message      String    @db.Text
  is_read      Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
}

model development_work {
  id          Int       @id @default(autoincrement())
  category    String?   @default("News") @db.VarChar(100)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  image       Bytes?
  video       Bytes?
  images      String?   @db.LongText
  videos      String?   @db.LongText
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  news_date   DateTime? @db.Date
  place       String?   @db.VarChar(255)
}

model event {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  main_image  Bytes?
  images      String?   @db.LongText
  created_at  DateTime? @default(now()) @db.Timestamp(0)
}

model images {
  id                   Int       @id @default(autoincrement())
  image                Bytes?
  isHeroSelectionImage Boolean   @default(false)
  title                String?   @db.VarChar(255)
  created_at           DateTime? @default(now()) @db.Timestamp(0)
  category             String?   @db.VarChar(255)
}

model news {
  id          Int       @id @default(autoincrement())
  category    String?   @default("News") @db.VarChar(100)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  image       Bytes?
  video       Bytes?
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  news_date   DateTime? @db.Date
}

enum blogs_status {
  draft
  published
}

model elections {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  electionYear Int
  category     String    @db.VarChar(255)
  description  String?   @db.Text
  mediaType    String?   @db.VarChar(50)
  mediaUrl     Bytes?    
  uploadDate   DateTime? @db.Date
  isActive     Boolean   @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
}
